<group name="mesa_ayuda,">
  <!-- Captura los eventos de autenticacion de la regla nativa 2501 -->
  <rule id="100001" level="3">
    <if_sid>2501</if_sid>
    <match>MesaDeAyuda</match>
    <description>Mesa de Ayuda: Intento fallido de login detectado.</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Regla de fuerza bruta: 5 intentos en 60 segundos -->
  <rule id="100002" level="10" frequency="4" timeframe="60">
    <if_matched_sid>100001</if_matched_sid>
    <description>Mesa de Ayuda: Fuerza bruta detectada (5+ fallos en 60s).</description>
    <group>authentication_failures, brute_force,</group>
  </rule>
</group>
